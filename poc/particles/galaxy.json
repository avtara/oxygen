{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "poc:galaxy",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.count = 720;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.count"
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 20
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 1.6, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 20
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.t = v.particle_random_1; v.arm = math.floor(v.particle_random_2 * 3); v.jit = v.particle_random_2 * 3 - v.arm - 0.5; v.radius = 0.2 + math.pow(v.t, 0.8) * 3.4 + (math.mod(v.particle_random_4 * 7.31, 1) - 0.5) * (0.15 + v.t * 0.35); v.angle = v.arm * 120 + v.t * 320 + v.jit * (14 + v.t * 26) + v.particle_age * 14 / (0.6 + v.radius);"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"math.cos(v.angle) * v.radius",
					"(v.particle_random_3 - 0.5) * 0.4 * (1 - v.t) * (1 - v.t)",
					"math.sin(v.angle) * v.radius"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"v.particle_random_1 < 0.012 ? 0.9 - v.particle_random_1 * 50 : (v.particle_random_4 < 0.04 ? 0.16 : (v.particle_random_4 > 0.83 ? 0.32 : 0.04 + (1 - v.particle_random_1) * 0.05))",
					"v.particle_random_1 < 0.012 ? 0.9 - v.particle_random_1 * 50 : (v.particle_random_4 < 0.04 ? 0.16 : (v.particle_random_4 > 0.83 ? 0.32 : 0.04 + (1 - v.particle_random_1) * 0.05))"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"1 - 0.55 * v.particle_random_1 + (v.particle_random_4 < 0.04 ? 0.3 : 0)",
					"0.85 - 0.55 * v.particle_random_1",
					"0.55 + 0.45 * v.particle_random_1",
					"(v.particle_random_1 < 0.012 ? 0.35 : (v.particle_random_4 > 0.83 ? 0.12 : 0.8)) * math.min(v.particle_age / 2, 1)"
				]
			}
		}
	},
	"oxygen": {
		"cameras": [
			{
				"name": "Tilted",
				"position": [
					0.2,
					3.4,
					3.9
				],
				"target": [
					0,
					0,
					0.2
				]
			}
		]
	}
}
