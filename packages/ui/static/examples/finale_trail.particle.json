{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "oxygen:finale_trail",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 3
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.05,
				"direction": "outwards"
			},
			"minecraft:particle_initial_speed": 0.4,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -1.5, 0],
				"linear_drag_coefficient": 1.5
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.5 + v.particle_random_1 * 0.5"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.09 * (1 - v.particle_age / v.particle_lifetime)", "0.09 * (1 - v.particle_age / v.particle_lifetime)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFE7B0",
						"0.4": "#B3FF9A3D",
						"1.0": "#00802A10"
					}
				}
			}
		}
	}
}
