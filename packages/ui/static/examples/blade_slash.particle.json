{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "oxygen:blade_slash",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.count = 110; v.tilt = 25 + (v.emitter_random_1 - 0.5) * 40;",
				"per_update_expression": "v.next = 0; v.next_render = 0;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.count * 2"
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 0.05,
				"sleep_time": 1.15
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.6
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.k = math.mod(v.next, v.count); v.next = v.next + 1; v.f = v.k / v.count; v.theta = -80 + v.f * 170; v.lift = math.sin(v.theta) * math.sin(v.tilt);",
				"per_render_expression": "v.kr = math.mod(v.next_render, v.count); v.glow = v.next_render >= v.count; v.next_render = v.next_render + 1; v.fr = v.kr / v.count; v.reach = v.particle_age / 0.13; v.since = v.particle_age - v.fr * 0.13; v.shown = v.since >= 0 ? math.clamp(1 - v.since / 0.38, 0, 1) : 0; v.body = math.sin(v.fr * 180);"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["math.cos(v.theta) * 1.7", "1.3 + v.lift * 1.7", "math.sin(v.theta) * 1.7 * math.cos(v.tilt)"],
				"direction": ["-math.sin(v.theta)", "math.cos(v.theta) * math.sin(v.tilt)", "math.cos(v.theta) * math.cos(v.tilt)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.glow ? 0.2 : 0.09", "(v.glow ? 0.42 : 0.06) * (0.2 + v.body) * (0.3 + 0.7 * v.shown)"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"v.glow ? 1 : 1",
					"v.glow ? 0.45 + 0.35 * v.shown : 0.92",
					"v.glow ? 0.12 : 0.7 + 0.3 * v.shown",
					"v.shown * v.shown * (v.glow ? 0.3 : 1)"
				]
			}
		}
	},
	"oxygen": {
		"cameras": [{ "name": "Front", "position": [0.3, 2.3, 4.1], "target": [0.5, 1.2, 0.2] }]
	}
}
