						"particle_effect": {
							"effect": "oxygen:finale_burst",
							"type": "emitter",
							"pre_effect_expression": "v.r = t.r; v.g = t.g; v.b = t.b;"
						}
					}
				]
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 2
			},
			"minecraft:emitter_shape_point": {
				"direction": ["v.tilt_x ?? 0", 1, "v.tilt_z ?? 0"]
			},
			"minecraft:particle_initial_speed": "16 + v.emitter_random_1 * 3",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -6, 0],
				"linear_drag_coefficient": 0.9
