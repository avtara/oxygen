			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "1.05 + v.emitter_random_2 * 0.35"
			},
			"minecraft:particle_lifetime_events": {
				"timeline": {
					"0.05": "trail",
					"0.15": "trail",
					"0.25": "trail",
					"0.35": "trail",
					"0.45": "trail",
					"0.55": "trail",
					"0.65": "trail",
					"0.75": "trail",
					"0.85": "trail",
					"0.95": "trail"
				},
				"expiration_event": "burst"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.3, 0.05],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["0.6 + 0.4 * (v.r ?? 1)", "0.6 + 0.4 * (v.g ?? 1)", "0.6 + 0.4 * (v.b ?? 1)", 1]
			}
		}
