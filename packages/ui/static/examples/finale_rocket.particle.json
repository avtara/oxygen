{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "oxygen:finale_rocket",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"events": {
			"trail": {
				"particle_effect": {
					"effect": "oxygen:finale_trail",
					"type": "emitter"
				}
			},
			"burst": {
				"sequence": [
					{ "expression": "t.r = v.r; t.g = v.g; t.b = v.b;" },
