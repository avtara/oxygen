{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "oxygen:shockwave",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.ring = 90; v.streaks = 60;",
				"per_update_expression": "v.next = 0; v.next_render = 0;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.ring + v.streaks + 1"
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 0.05,
				"sleep_time": 1.75
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0.04, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1.2
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.k = v.next; v.next = v.next + 1; v.t = v.particle_age / v.particle_lifetime; v.ease = 1 - math.pow(1 - v.t, 3); v.angle = v.k < v.ring ? v.k / v.ring * 360 : v.particle_random_2 * 360; v.out = v.k < v.ring ? 0.3 + v.ease * 3.6 : (v.k < v.ring + v.streaks ? 0.4 + v.ease * (2.4 + v.particle_random_3 * 2.2) : 0);",
				"per_render_expression": "v.kr = v.next_render; v.next_render = v.next_render + 1; v.t = v.particle_age / v.particle_lifetime; v.ring_part = v.kr < v.ring; v.flash = v.kr >= v.ring + v.streaks;"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["math.cos(v.angle) * v.out", "0", "math.sin(v.angle) * v.out"],
				"direction": ["math.cos(v.angle)", "0", "math.sin(v.angle)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"v.flash ? 1.6 * (1 - v.t * 0.5) : (v.ring_part ? 0.22 + v.t * 0.3 : 0.3 * (1 - v.t))",
					"v.flash ? 1.6 * (1 - v.t * 0.5) : (v.ring_part ? 0.12 + v.t * 0.25 : 0.03 * (1 - v.t))"
				],
				"facing_camera_mode": "direction_y",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"v.flash ? 1 : (v.ring_part ? 0.55 + 0.45 * (1 - v.t) : 1)",
					"v.flash ? 0.6 : (v.ring_part ? 0.8 + 0.2 * (1 - v.t) : 0.85)",
					"v.flash ? 0.3 : 1",
					"v.flash ? 0.55 * math.pow(1 - v.t, 3) : (v.ring_part ? 0.55 * math.pow(1 - v.t, 1.5) : 0.9 * (1 - v.t))"
				]
			}
		}
	},
	"oxygen": {
		"cameras": [{ "name": "Above", "position": [3.6, 3.6, 4.6], "target": [0, 0, 0] }]
	}
}
