{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "oxygen:glow_orb",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 36,
				"max_particles": 120
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 4
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 1.2, 0],
				"radius": 0.12,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "1.6 + v.particle_random_1 * 1.2"
			},
			"minecraft:particle_initial_speed": "v.particle_random_2 < 0.25 ? 0.9 : 0.12",
			"minecraft:particle_initialization": {
				"per_render_expression": "v.layer = v.particle_random_2 < 0.25 ? 0 : (v.particle_random_2 < 0.7 ? 1 : 2); v.fade = math.sin(v.particle_age / v.particle_lifetime * 180);"
			},
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0.25, 0],
				"linear_drag_coefficient": 1.2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(v.layer == 0 ? 0.07 : (v.layer == 1 ? 0.32 : 0.85)) * (0.85 + v.fade * 0.15)",
					"(v.layer == 0 ? 0.07 : (v.layer == 1 ? 0.32 : 0.85)) * (0.85 + v.fade * 0.15)"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"v.layer == 2 ? 0.3 : 1",
					"v.layer == 0 ? 0.92 : (v.layer == 1 ? 0.42 : 0.45)",
					"v.layer == 0 ? 0.62 : (v.layer == 1 ? 0.78 : 1)",
					"(v.layer == 0 ? 1 : (v.layer == 1 ? 0.22 : 0.07)) * v.fade"
				]
			}
		}
	},
	"oxygen": {
		"cameras": [{ "name": "Close", "position": [1.9, 1.7, 2.3], "target": [0, 1.3, 0] }]
	}
}
