{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "oxygen:black_hole",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 260,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 10
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.particle_random_4 < 0.12 ? 1.2 : 2.6 + v.particle_random_1 * 1.4"
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.t = v.particle_age / v.particle_lifetime; v.jet = v.particle_random_4 < 0.12; v.r = 0.55 + 3.2 * (0.7 + 0.3 * v.particle_random_2) * math.pow(1 - v.t, 0.8); v.a = v.particle_random_3 * 360 + 240 * v.t + 520 * v.t * v.t; v.side = v.particle_random_2 < 0.5 ? -1 : 1;",
				"per_render_expression": "v.t = v.particle_age / v.particle_lifetime; v.jet = v.particle_random_4 < 0.12; v.heat = v.jet ? 1 : math.clamp(1.25 - (0.55 + 3.2 * (0.7 + 0.3 * v.particle_random_2) * math.pow(1 - v.t, 0.8)) / 3.2, 0, 1);"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"v.jet ? math.sin(v.particle_age * 900 + v.particle_random_1 * 360) * 0.06 : math.cos(v.a) * v.r",
					"v.jet ? 2.2 + v.side * (0.3 + v.t * 3.4) : 2.2 + math.sin(v.a * 2 + v.particle_random_1 * 360) * 0.03",
					"v.jet ? math.cos(v.particle_age * 900 + v.particle_random_1 * 360) * 0.06 : math.sin(v.a) * v.r"
				],
				"direction": ["v.jet ? 0 : -math.sin(v.a)", "v.jet ? 1 : 0", "v.jet ? 0 : math.cos(v.a)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.jet ? 0.22 : 0.16 + v.heat * 0.16", "v.jet ? 0.05 : 0.025 + v.heat * 0.025"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"v.jet ? 0.45 : 1",
					"v.jet ? 0.75 : 0.25 + 0.7 * v.heat",
					"v.jet ? 1 : 0.08 + 0.85 * v.heat * v.heat",
					"math.min(v.t * 8, 1) * (1 - v.t * v.t) * (v.jet ? 0.7 : 0.35 + 0.65 * v.heat)"
				]
			}
		}
	},
	"oxygen": {
		"cameras": [{ "name": "Tilted", "position": [0.5, 4.7, 5.6], "target": [0, 2.0, 0] }]
	}
}
