{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "oxygen:finale_burst",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"events": {
			"crackle": {
				"randomize": [
					{ "weight": 4 },
					{
						"weight": 1,
						"particle_effect": {
							"effect": "oxygen:finale_trail",
							"type": "emitter"
						}
					}
				]
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 170
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.1,
				"direction": "outwards"
			},
			"minecraft:particle_initial_speed": "10 + v.particle_random_1 * 3",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -3.2, 0],
				"linear_drag_coefficient": 2.4
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "1.5 + v.particle_random_2 * 0.9"
			},
			"minecraft:particle_lifetime_events": {
				"timeline": {
					"1.0": "crackle"
				}
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.16 + 0.5 * math.pow(1 - v.particle_age / v.particle_lifetime, 3)", "0.06 + 0.03 * (1 - v.particle_age / v.particle_lifetime)"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"math.lerp(1, v.r ?? 1, math.min(v.particle_age * 5, 1))",
					"math.lerp(1, v.g ?? 0.7, math.min(v.particle_age * 5, 1))",
					"math.lerp(1, v.b ?? 0.3, math.min(v.particle_age * 5, 1))",
					"math.pow(1 - v.particle_age / v.particle_lifetime, 0.7) * (0.7 + 0.3 * math.random(0, 1))"
				]
			}
		}
	}
}
