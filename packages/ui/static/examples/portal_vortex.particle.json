{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "oxygen:portal_vortex",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 150,
				"max_particles": 700
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 8
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "1.6 + v.particle_random_1 * 1.4"
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.t = v.particle_age / v.particle_lifetime; v.core = v.particle_random_4 < 0.06; v.r = v.core ? 0 : 2.1 * (0.75 + 0.25 * v.particle_random_2) * math.pow(1 - v.t, 1.4) + 0.08; v.a = v.particle_random_3 * 360 + 260 * v.t + 420 * v.t * v.t;",
				"per_render_expression": "v.t = v.particle_age / v.particle_lifetime; v.core = v.particle_random_4 < 0.06;"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["math.cos(v.a) * v.r", "1.9 + math.sin(v.a) * v.r", "math.sin(v.a * 3 + v.particle_random_1 * 360) * 0.06"],
				"direction": ["-math.sin(v.a)", "math.cos(v.a)", "0"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.core ? 0.9 : 0.06 + (1 - v.t) * 0.16", "v.core ? 0.9 : 0.025 + (1 - v.t) * 0.02"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"v.core ? 0.55 : 0.55 + 0.45 * v.t * v.t",
					"v.core ? 0.25 : 0.12 + 0.85 * v.t * v.t * v.t",
					"1",
					"v.core ? 0.08 * math.sin(v.t * 180) : math.min(v.t * 6, 1) * (0.25 + 0.75 * v.t)"
				]
			}
		}
	},
	"oxygen": {
		"cameras": [{ "name": "Facing the portal", "position": [1.6, 2.1, 4.6], "target": [0, 1.9, 0] }]
	}
}
