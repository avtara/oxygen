{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "oxygen:ember_drift",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 70,
				"max_particles": 400
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 6
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, 0.1, 0],
				"radius": 1.4,
				"plane_normal": [0, 1, 0],
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "2.4 + v.particle_random_1 * 1.6"
			},
			"minecraft:particle_initial_speed": "1.1 + v.particle_random_2 * 1.2",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"math.sin(v.particle_age * 170 + v.particle_random_3 * 360) * 3.2",
					0.7,
					"math.cos(v.particle_age * 140 + v.particle_random_4 * 360) * 3.2"
				],
				"linear_drag_coefficient": 0.9
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.13 + v.particle_random_2 * 0.08", "0.03 + v.particle_random_2 * 0.025"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFF6D6",
						"0.15": "#FFFFC24A",
						"0.5": "#E6FF6A1F",
						"0.8": "#99D12A12",
						"1.0": "#00400808"
					}
				}
			}
		}
	},
	"oxygen": {
		"cameras": [{ "name": "Low", "position": [3.4, 1.1, 4.2], "target": [0, 1.6, 0] }]
	}
}
