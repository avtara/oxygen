{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "oxygen:aurora",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.count = 900;",
				"per_update_expression": "v.next = 0; v.next_render = 0;"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "v.count"
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 12
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 12
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.index = v.next; v.next = v.next + 1;",
				"per_render_expression": "v.r = v.next_render; v.next_render = v.next_render + 1; v.t = v.r / v.count;"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"(v.index / v.count - 0.5) * 10",
					"2.6 + math.sin(v.index * 5 + v.particle_age * 50) * 0.18",
					"math.sin(v.index * 6 + v.particle_age * 35) * 0.9 + math.sin(v.index * 2.3 - v.particle_age * 22) * 0.6"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.12", "1.9 + math.sin(v.r * 3 + v.particle_age * 40) * 0.35"],
				"facing_camera_mode": "lookat_y",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 16],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"0.15 + 0.75 * v.t * v.t",
					"0.95 - 0.55 * v.t",
					"0.45 + 0.55 * v.t",
					"0.085 * math.min(v.particle_age / 1.5, 1) * math.min((v.particle_lifetime - v.particle_age) / 1.5, 1) * (0.75 + 0.25 * math.sin(v.r * 17 + v.particle_age * 90))"
				]
			}
		}
	},
	"oxygen": {
		"cameras": [{ "name": "Under the sky", "position": [1.5, 0.6, 7.5], "target": [0, 2.7, 0] }]
	}
}
